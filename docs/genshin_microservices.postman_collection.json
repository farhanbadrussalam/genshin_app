	"item": [
		{
			"name": "1. HoYoLAB Microservice (Direct FastAPI - Port 8001)",
			"description": "Endpoint langsung ke Python FastAPI Microservice yang berjalan di port 8001 (genshin.py engine).",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{hoyolab_base_url}}/health",
							"host": [
								"{{hoyolab_base_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Mengecek status ketersediaan microservice Python HoYoLAB."
					},
					"response": [
						{
							"name": "Success Example",
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "content-type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"status\": \"ok\",\n    \"service\": \"hoyolab-service\"\n}"
						}
					]
				},
				{
					"name": "Get Characters & Battle Chronicle",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ltuid_v2\": \"{{ltuid_v2}}\",\n    \"ltoken_v2\": \"{{ltoken_v2}}\",\n    \"uid\": {{uid}}\n}"
						},
						"url": {
							"raw": "{{hoyolab_base_url}}/api/genshin/characters",
							"host": [
								"{{hoyolab_base_url}}"
							],
							"path": [
								"api",
								"genshin",
								"characters"
							]
						},
						"description": "Mengambil data Battle Chronicle akun Genshin Impact langsung dari HoYoLAB API menggunakan genshin.py.\n\nBody memerlukan:\n- `ltuid_v2`: Cookie ltuid_v2 dari hoyolab.com\n- `ltoken_v2`: Cookie ltoken_v2 dari hoyolab.com\n- `uid`: UID game Genshin Impact pemain (9-10 digit)"
					},
					"response": []
				},
				{
					"name": "Get OpenAPI Specification JSON",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{hoyolab_base_url}}/openapi.json",
							"host": [
								"{{hoyolab_base_url}}"
							],
							"path": [
								"openapi.json"
							]
						},
						"description": "Mengambil spesifikasi OpenAPI / Swagger JSON dari FastAPI microservice."
					},
					"response": []
				}
			]
		},
